<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.macplex.drivecheck</string>
    <key>ProgramArguments</key>
    <array>
        <string>${PROJECT_DIR}/scripts/check-drive-health.sh</string>
        <string>--quick</string>
        <string>--quiet</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/drive-health.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/drive-health.log</string>
</dict>
</plist>
