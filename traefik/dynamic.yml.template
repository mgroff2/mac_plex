http:
  routers:
    traefik-dashboard:
      rule: "Host(`traefik.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: api@internal
      middlewares:
        - all-ipwhitelist

    adminer:
      rule: "Host(`adminer.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: adminer-service
      middlewares:
        - all-ipwhitelist

    bazarr:
      rule: "Host(`bazarr.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: bazarr-service
      middlewares:
        - all-ipwhitelist
    
    beszel:
      rule: "Host(`beszel.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: beszel-service
      middlewares:
        - all-ipwhitelist

    dozzle:
      rule: "Host(`dozzle.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: dozzle-service
      middlewares:
        - all-ipwhitelist

    heimdall:
      rule: "Host(`heimdall.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: heimdall-service
      middlewares:
        - all-ipwhitelist
        - heimdall-headers

    it-tools:
      rule: "Host(`it-tools.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: it-tools-service
      middlewares:
        - all-ipwhitelist

    lidarr:
      rule: "Host(`lidarr.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: lidarr-service
      middlewares:
        - all-ipwhitelist

    n8n:
      rule: "Host(`n8n.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: n8n-service
      middlewares:
        - all-ipwhitelist

    nzbget:
      rule: "Host(`nzbget.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: nzbget-service
      middlewares:
        - all-ipwhitelist

    ombi:
      rule: "Host(`ombi.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: ombi-service

    portainer:
      rule: "Host(`portainer.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: portainer-service
      middlewares:
        - all-ipwhitelist

    prowlarr:
      rule: "Host(`prowlarr.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: prowlarr-service
      middlewares:
        - all-ipwhitelist

    radarr:
      rule: "Host(`radarr.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: radarr-service
      middlewares:
        - all-ipwhitelist

    sonarr:
      rule: "Host(`sonarr.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: sonarr-service
      middlewares:
        - all-ipwhitelist

    tautulli:
      rule: "Host(`tautulli.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: tautulli-service
      middlewares:
        - all-ipwhitelist

    uptime-kuma:
      rule: "Host(`uptime.${DOMAIN}`)"
      entryPoints:
        - websecure
      service: uptime-kuma-service
      middlewares:
        - all-ipwhitelist

  services:
    adminer-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8090"

    bazarr-service:
      loadBalancer:
        servers:
          - url: "http://localhost:6767"

    beszel-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8091"

    dozzle-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8092"

    heimdall-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8282"

    it-tools-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8084"

    lidarr-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8686"

    n8n-service:
      loadBalancer:
        servers:
          - url: "http://localhost:5678"

    nzbget-service:
      loadBalancer:
        servers:
          - url: "http://localhost:6789"

    ombi-service:
      loadBalancer:
        servers:
          - url: "http://localhost:3579"

    portainer-service:
      loadBalancer:
        servers:
          - url: "http://localhost:9000"

    prowlarr-service:
      loadBalancer:
        servers:
          - url: "http://localhost:9696"

    radarr-service:
      loadBalancer:
        servers:
          - url: "http://localhost:7878"

    sonarr-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8989"

    tautulli-service:
      loadBalancer:
        servers:
          - url: "http://localhost:8181"

    uptime-kuma-service:
      loadBalancer:
        servers:
          - url: "http://localhost:3001"

  middlewares:
    all-ipwhitelist:
      ipAllowList:
        sourceRange:
${IP_ALLOW_LIST}
    heimdall-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"
          X-Forwarded-Host: "heimdall.${DOMAIN}"
        customResponseHeaders:
          Content-Security-Policy: "upgrade-insecure-requests"
