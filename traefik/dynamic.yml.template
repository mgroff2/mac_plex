  middlewares:
    all-ipwhitelist:
      ipAllowList:
        sourceRange:
${IP_ALLOW_LIST}
    heimdall-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"
          X-Forwarded-Host: "heimdall.${DOMAIN}"
        customResponseHeaders:
          Content-Security-Policy: "upgrade-insecure-requests"
          
tcp:
  routers:
    mysql-router:
      entryPoints:
        - mysql
      rule: "HostSNI(`*`)"
      service: mysql-service
      middlewares:
        - mysql-whitelist

  services:
    mysql-service:
      loadBalancer:
        servers:
          - address: "mysql:3306"

  middlewares:
    mysql-whitelist:
      ipAllowList:
        sourceRange:
${IP_ALLOW_LIST}
